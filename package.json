{
  "name": "model-pear",
  "version": "2.0.0",
  "description": "Software Transaction Structuring Tool - Monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @model-pear/web dev",
    "build": "pnpm --filter @model-pear/calculator build && pnpm --filter @model-pear/web build",
    "preview": "pnpm --filter @model-pear/web preview",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --if-present test:watch",
    "test:e2e": "pnpm --filter @model-pear/web test:e2e",
    "test:e2e:ui": "pnpm --filter @model-pear/web test:e2e:ui",
    "check": "node scripts/check-theme-hex.mjs && pnpm -r check",
    "check:theme-hex": "node scripts/check-theme-hex.mjs",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [
    "software",
    "transaction",
    "pricing",
    "calculator",
    "transfer-pricing",
    "south-africa"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
