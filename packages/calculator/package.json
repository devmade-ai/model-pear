{
  "name": "@model-pear/calculator",
  "version": "1.0.0",
  "description": "Pure TypeScript calculation engine for software transaction structuring",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "import": "./src/models/index.ts"
    },
    "./projections": {
      "types": "./src/projections/index.ts",
      "import": "./src/projections/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "keywords": [
    "calculator",
    "financial",
    "transaction",
    "cost-plus",
    "npv",
    "irr",
    "transfer-pricing"
  ],
  "license": "MIT"
}
